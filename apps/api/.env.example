# API — NestJS Backend
NODE_ENV=development
PORT=4000

# Database (PostgreSQL via Docker service name)
DATABASE_URL=postgresql://ros_user:ros_password@postgres:5432/restaurant_db

# Cache (Redis via Docker service name)
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-in-production-super-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
# In Docker: web service at http://web:3000, dashboard at http://dashboard:3001
# In production: add your domains
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://web:3000,http://dashboard:3001,https://domena.pl,https://admin.domena.pl

# Payments (Etap 7)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYU_CLIENT_ID=...
PAYU_CLIENT_SECRET=...

# Printer Service
PRINTER_SERVICE_URL=http://printer-service:5000
