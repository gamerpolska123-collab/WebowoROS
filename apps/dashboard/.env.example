# Dashboard — Next.js Frontend (Admin)
NEXT_PUBLIC_API_URL=http://api:4000/v1
NEXT_PUBLIC_WS_URL=ws://api:4001

# In production via Nginx:
# NEXT_PUBLIC_API_URL=https://api.domena.pl/v1
# NEXT_PUBLIC_WS_URL=wss://ws.domena.pl

# Must match API JWT_SECRET for middleware verification
JWT_SECRET=your-jwt-secret-here
