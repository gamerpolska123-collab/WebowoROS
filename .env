# ============================================
# WebowoROS — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/weboworos?schema=public

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Authentication
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=Q/P+7xsQAiAEp62DEEQmEnQVF7vKqrbUgJ4TLBLOHCI=
JWT_REFRESH_SECRET=change_me_to_different_random_32_char_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# API Server
# ============================================
API_PORT=4000
WS_PORT=4001
NODE_ENV=development
API_URL=http://localhost:4000

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# Frontend URLs
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001
DASHBOARD_URL=http://localhost:3001

# ============================================
# Stripe (Payment Processing)
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# PayU (Polish Payment Provider)
# ============================================
PAYU_POS_ID=...
PAYU_MD5_KEY=...
PAYU_OAUTH_CLIENT_ID=...
PAYU_OAUTH_CLIENT_SECRET=...
PAYU_SANDBOX=true

# ============================================
# Cloudinary (Image Uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ============================================
# Sentry (Error Tracking)
# ============================================
SENTRY_DSN=https://...@sentry.io/...

# ============================================
# Plausible Analytics
# ============================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.pl
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# ============================================
# Printer Service
# ============================================
PRINTER_SERVICE_PORT=5000
PRINTER_REDIS_QUEUE=printer-queue

# ============================================
# Site Configuration
# ============================================
SITE_NAME=WebowoROS
FREE_DELIVERY_THRESHOLD=50
MIN_ORDER_VALUE=20
