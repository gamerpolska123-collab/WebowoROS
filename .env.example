# ============================================
# WebowoROS - Environment Configuration
# ============================================

# Database
DB_USER=ros_user
DB_PASSWORD=ros_password
DB_NAME=restaurant_db
DATABASE_URL=postgresql://ros_user:ros_password@postgres:5432/restaurant_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-in-production-min-32-chars-long

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API URLs (for frontend apps)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# Payments (optional - for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

PAYU_CLIENT_ID=...
PAYU_CLIENT_SECRET=...

# Sentry (optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_DASHBOARD=

# Domain (for production)
DOMAIN=localhost

# Upload
UPLOAD_BASE_URL=/uploads/products
